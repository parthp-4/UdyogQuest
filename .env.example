# APP_DATA_MODE controls the single runtime-mode switch (see lib/runtime/mode.ts).
# "demo" (default if unset): serve the curated corpus in lib/demo/corpus.ts. No database needed.
# "live": serve persisted PostgreSQL data. DATABASE_URL is then REQUIRED -- the app fails
#         loudly at request time rather than silently falling back to demo data if it's missing.
APP_DATA_MODE="demo"

# DATABASE_URL: app runtime queries. DIRECT_URL: migrations only (required by Supabase's
# transaction-pooler setup -- see README.md "Environment Variables"). If you're not on
# Supabase's pooler, both can point at the same database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/udyogquest"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/udyogquest"
GEMINI_API_KEY="replace-with-server-side-key"

# Required in live mode to authenticate both the scheduled Vercel Cron trigger and any
# manual POST to /api/ingest/run. Vercel automatically sends this as
# `Authorization: Bearer $CRON_SECRET` for the cron-triggered request.
CRON_SECRET="replace-with-vercel-cron-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
